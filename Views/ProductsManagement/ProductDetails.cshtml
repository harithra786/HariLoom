        function fnClrModal(){
            $('#productForm')[0].reset();
            $('#productForm').parsley().reset();
            $('#productAddModal').modal('hide');
            //tags.clear();
            //$('#tagContainer').empty();
            $('.clrTxtValues').val("");
            $('#specificationContainer').empty();
            $('#washCareContainer').empty();
            $('#colorVariantContainer').empty();
            $('#imagePreviewContainer').empty();
            $('#imageCountInfo').empty();
            selectedProductImages = [];
            $('#productDescriptionEditor').summernote('code', '');
            // Remove cover image preview if exists
            $('#coverImage').siblings('div:has(img)').remove();
            // Reset modal title and file input requirements
            const modalTitle = $('#productAddModal').find('.modal-title');
            modalTitle.text('Add Product');
            $('#coverImage').prop('required', true);
            $('#productImages').prop('required', true);
        }

        // Renders image previews with remove (×) buttons
        function renderImagePreviews() {
            const previewContainer = $('#imagePreviewContainer');
            previewContainer.html('');

            selectedProductImages.forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const wrapper = $(`
                        <div class="img-preview-wrapper">
                            <button type="button" class="img-preview-remove" data-idx="${idx}" title="Remove image">&times;</button>
                            <img src="${e.target.result}" alt="Preview">
                            <span class="img-preview-index">${idx + 1}/${selectedProductImages.length}</span>
                        </div>
                    `);
                    // Need to insert at the correct position
                    const children = previewContainer.children();
                    if (idx >= children.length) {
                        previewContainer.append(wrapper);
                    } else {
                        $(children[idx]).before(wrapper);
                    }
                };
                reader.readAsDataURL(file);
            });
        }

        // Remove image by index (delegated click)
        $(document).on('click', '.img-preview-remove', function () {
            const idx = parseInt($(this).data('idx'));
            selectedProductImages.splice(idx, 1);
            $('#imageCountInfo').text(selectedProductImages.length > 0 ? `${selectedProductImages.length} image(s) selected` : '').css('color', '#6c757d');
            renderImagePreviews();
        });
