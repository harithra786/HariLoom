        function loadMainCategory() {
            return new Promise(function (resolve, reject) {
                $.get('@Url.Action("GetAllActiveProductMainCategories", "ProductsManagement")')
                    .done(function (response) {
                        $('#mainCategory').html("");

                        let options = `<option value="" selected disabled>Select main category</option>`;
                        response.data.forEach((cat, idx) => {
                            options += `<option value="${cat.mstProductMainCategoryId}">${cat.mainCategoryName}</option>`;
                        });
                        $('#mainCategory').html(options);

                        // Session value selection
                        const $mainCategory = $('#mainCategory');
                        const selectedCategoryId = sessionStorage.getItem('selectedCategoryId');
                        if (selectedCategoryId) {
                            $mainCategory.val(selectedCategoryId).trigger('change');
                        } else {
                            $mainCategory.prop("selectedIndex", 0); // select default
                        }
                        resolve();
                    })
                    .fail(function (err) { console.error('Failed to load main categories', err); reject(err); });
            });
        }

        function loadSubCategory(ele) {
            return new Promise(function (resolve, reject) {
                var id = $(ele).val();
                if (!id) {
                    $('#subCategory').html('<option value="" selected disabled>Select sub category</option>');
                    resolve();
                    return;
                }
                $.get('@Url.Action("GetAllActiveProductSubCategoriesByMainCategoryId", "ProductsManagement")', { id: id })
                    .done(function (response) {
                        $('#subCategory').html("");

                        let options = `<option value="" selected disabled>Select sub category</option>`;
                        response.data.forEach((cat) => {
                            options += `<option value="${cat.mstProductSubCategoryId}">${cat.subCategoryName}</option>`;
                        });
                        $('#subCategory').html(options);

                        const $subCategory = $('#subCategory');
                        const selectedSubCategoryId = sessionStorage.getItem('selectedSubCategoryId');
                        if (selectedSubCategoryId) {
                            $subCategory.val(selectedSubCategoryId);
                        } else {
                            $subCategory.prop("selectedIndex", 0);
                        }
                        resolve();
                    })
                    .fail(function (err) { console.error('Failed to load sub categories', err); reject(err); });
            });
        }


        function fnSaveOrUpdateProductDetails() {
            console.log('fnSaveOrUpdateProductDetails called');
            var now = Date.now();
            if (isSaving) {
                var elapsed = now - lastSaveStart;
                console.log('Save already in progress, elapsed(ms):', elapsed);
                // if previous save started long ago (>15s), consider it stale and allow a retry
                if (elapsed < 15000) {
                    console.log('Aborting new save because previous is recent.');
                    return;
                }
                console.log('Previous save appears stale, resetting state and continuing.');
                isSaving = false;
                $('#saveBtn').prop('disabled', false);
            }

            var ajaxStarted = false;
            isSaving = true;
            lastSaveStart = Date.now();
            $('#saveBtn').prop('disabled', true);

            const isEditMode = $('#productTableId').val() && $('#productTableId').val() > 0;

            // For edit mode: make file inputs not required
            if (isEditMode) {
                $('#coverImage').prop('required', false);
                $('#productImages').prop('required', false);
            } else {
                // For add mode: keep them required
                $('#coverImage').prop('required', true);
                $('#productImages').prop('required', true);
            }

            // Validate category selection
            if ($('#mainCategory').length && $('#mainCategory').is(':visible')) {
                if (!$('#mainCategory').val()) {
                    alert('Please select a main category.');
                    $('#mainCategory').focus();
                    isSaving = false;
                    $('#saveBtn').prop('disabled', false);
                    return false;
                }
            }

            if ($('#subCategory').length && $('#subCategory').is(':visible')) {
                if (!$('#subCategory').val()) {
                    alert('Please select a sub category.');
                    $('#subCategory').focus();
                    isSaving = false;
                    $('#saveBtn').prop('disabled', false);
                    return false;
                }
            }

            // Minimal client-side validation (avoid Parsley binding issues)
            // var requiredFields = [
            //     { selector: '#productName', name: 'Product Name' },
            //     { selector: '#productDisplayId', name: 'Product ID' },
            //     { selector: '#productSimplePrice', name: 'Price' }
            // ];

            // // Only require main/sub category if those elements actually exist on the page and are visible
            // if ($('#mainCategory').length && $('#mainCategory').is(':visible')) requiredFields.push({ selector: '#mainCategory', name: 'Main Category' });
            // if ($('#subCategory').length && $('#subCategory').is(':visible')) requiredFields.push({ selector: '#subCategory', name: 'Sub Category' });

            // for (var rf of requiredFields) {
            //     var $el = $(rf.selector);
            //     if ($el.length && $el.is(':visible') && (!$el.val() || $el.val().toString().trim() === '' || $el.val() === '0')) {
            //         alert('Please enter/select: ' + rf.name);
            //         $el.focus();
            //         return;
            //     }
            // }

            // try {
            //     console.log('Building FormData');
            // } catch (e) {
            //     console.error('Error before building FormData', e);
            // }

            // Validate product images (max 6)
            if (selectedProductImages.length > 6) {
                alert("Maximum 6 images are allowed. Please remove some images.");
                isSaving = false;
                $('#saveBtn').prop('disabled', false);
                return false;
            }

            const formData = new FormData();
            formData.append("productId", $('#productTableId').val() || 0);
            formData.append("productName", $('#productName').val());
            formData.append("productDisplayId", $('#productDisplayId').val());
            formData.append('sizeVariants', $('input[name="productAvailableSizes"]:checked').map(function(){ return this.value; }).get().join(',') || '');
            formData.append("productDescription", $('#productDescriptionEditor').summernote('code'));
            formData.append("basePrice", parseInt($('#productPrice').val()) || 0);
            formData.append("createdBy", sessionStorage.getItem('userId') || 1);
            formData.append("mstProductMainCategoryId", $('#mainCategory').val() || 0);
            formData.append("mstProductSubCategoryId", $('#subCategory').val() || 0);

            // Only append cover image if a new one is selected
            const coverImage = $('#coverImage')[0].files[0];
            if (coverImage) {
                formData.append("coverImage", coverImage);
            }

            // Append product images from managed array
            for (let j = 0; j < selectedProductImages.length; j++) {
                formData.append('productImages', selectedProductImages[j]);
            }

            $('.spec-row').each(function (i) {
                const title = $(this).find('.spec-title').val() || $(this).find('input[name="specTitle"]').val();
                const value = $(this).find('.spec-value').val() || $(this).find('input[name="specValue"]').val();

                if (title && value) {
                    formData.append(`specifications[${i}].title`, title);
                    formData.append(`specifications[${i}].value`, value);
                }
            });

            $('.washcare-row').each(function (i) {
                const instruction = $(this).find('.washcare-instruction').val() || $(this).find('input[name="washCareInstruction"]').val();

                if (instruction) {
                    formData.append(`washCares[${i}].instruction`, instruction);
                }
            });

            // Debug: log FormData keys (files not fully serializable)
            try {
                for (var pair of formData.entries()) {
                    console.log('FormData entry:', pair[0], pair[1]);
                }
            } catch (e) { console.log('Could not enumerate FormData entries', e); }

            // Submit the form
            $.ajax({
                url: '@Url.Action("SaveOrUpdateProduct", "ProductsManagement")',
                type: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    console.log('SaveOrUpdateProduct response:', res);
                    if (res && res.success) {
                        alert(res.message || "Product saved successfully!");
                        fnClrModal();
                        // ensure the list refreshes after a short delay to account for any DB latency
                        setTimeout(loadProducts, 300);
                    } else {
                        alert(res && res.message ? res.message : "Error on Product Save!");
                    }
                    // reset saving state and re-enable button
                    isSaving = false;
                    $('#saveBtn').prop('disabled', false);
                },
                error: function (xhr) {
                    console.error('SaveOrUpdateProduct error', xhr);
                    var msg = 'Error on Product Save!';
                    try {
                        var json = xhr && xhr.responseJSON ? xhr.responseJSON : JSON.parse(xhr.responseText || '{}');
                        if (json && json.message) msg = json.message;
                    } catch (e) { }
                    alert(msg);
                    isSaving = false;
                    $('#saveBtn').prop('disabled', false);
                }
            });
        }

