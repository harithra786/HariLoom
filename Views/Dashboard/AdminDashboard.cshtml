@model hariloom.Models.DTOs.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row mt-2">
        <!-- Active Products -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card text-center shadow-sm h-100 animate__animated animate__fadeInUp">
                <div class="card-body">
                    <div class="mb-2">
                        <i class="bx bx-package fs-1 text-primary"></i>
                    </div>
                    <h6 class="card-title">Active Products</h6>
                    <h3 class="mb-2">@Model.ActiveProducts</h3>
                    <small class="text-muted">Total items listed for sale</small>
                </div>
            </div>
        </div>
        <!-- Total Users -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card text-center shadow-sm h-100 animate__animated animate__fadeInUp animate__delay-1s">
                <div class="card-body">
                    <div class="mb-2">
                        <i class="bx bx-user fs-1 text-info"></i>
                    </div>
                    <h6 class="card-title">Website Users</h6>
                    <h3 class="mb-2">@Model.TotalUsers</h3>
                    <small class="text-muted">Registered shoppers</small>
                </div>
            </div>
        </div>
        <!-- Pending Orders -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card text-center shadow-sm h-100 animate__animated animate__fadeInUp animate__delay-2s">
                <div class="card-body">
                    <div class="mb-2">
                        <i class="bx bx-time-five fs-1 text-warning"></i>
                    </div>
                    <h6 class="card-title">Pending Orders</h6>
                    <h3 class="mb-2">@Model.PendingOrders</h3>
                    <small class="text-muted">Awaiting fulfillment</small>
                </div>
            </div>
        </div>
        <!-- In Transit Orders -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card text-center shadow-sm h-100 animate__animated animate__fadeInUp">
                <div class="card-body">
                    <div class="mb-2">
                        <i class="bx bx-truck fs-1 text-secondary"></i>
                    </div>
                    <h6 class="card-title">In-Transit Orders</h6>
                    <h3 class="mb-2">@Model.InTransitOrders</h3>
                    <small class="text-muted">Currently shipping</small>
                </div>
            </div>
        </div>
        <!-- Completed Orders -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card text-center shadow-sm h-100 animate__animated animate__fadeInUp animate__delay-1s">
                <div class="card-body">
                    <div class="mb-2">
                        <i class="bx bx-check-circle fs-1 text-success"></i>
                    </div>
                    <h6 class="card-title">Completed Orders</h6>
                    <h3 class="mb-2">@Model.CompletedOrders</h3>
                    <small class="text-muted">Successfully delivered</small>
                </div>
            </div>
        </div>
        <!-- Cancelled Orders -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card text-center shadow-sm h-100 animate__animated animate__fadeInUp animate__delay-2s">
                <div class="card-body">
                    <div class="mb-2">
                        <i class="bx bx-x-circle fs-1 text-danger"></i>
                    </div>
                    <h6 class="card-title">Cancelled Orders</h6>
                    <h3 class="mb-2">@Model.CancelledOrders</h3>
                    <small class="text-muted">Cancelled by admin</small>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!-- Product Sales Table -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100 shadow-sm animate__animated animate__fadeInUp">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Product Sales Report</h5>
                    <i class="bx bx-package fs-4 text-primary"></i>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Product ID</th>
                                    <th>Product Name</th>
                                    <th>Size</th>
                                    <th>Quantity Available</th>
                                    <th>Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.ProductSales)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrEmpty(sale.ProductDisplayId) ? sale.ProductId.ToString() : sale.ProductDisplayId)</td>
                                        <td>@sale.ProductName</td>
                                        <td>@sale.Size</td>
                                        <td>@sale.QuantityAvailable</td>
                                        <td>₹@sale.Revenue.ToString("0.00")</td>
                                    </tr>
                                }
                                @if(!Model.ProductSales.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No sales data available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- Recent Orders Table -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100 shadow-sm animate__animated animate__fadeInUp animate__delay-1s">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Orders</h5>
                    <i class="bx bx-receipt fs-4 text-info"></i>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>@order.OrderId</td>
                                        <td>@order.CustomerName</td>
                                        <td>@order.Date</td>
                                        <td>
                                            @if (order.Status == 1)
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                            else if (order.Status == 2)
                                            {
                                                <span class="badge bg-info">In-Transit</span>
                                            }
                                            else if (order.Status == 3)
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else if (order.Status == 4)
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Unknown</span>
                                            }
                                        </td>
                                        <td>₹@order.Total.ToString("0.00")</td>
                                    </tr>
                                }
                                @if(!Model.RecentOrders.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No recent orders found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
