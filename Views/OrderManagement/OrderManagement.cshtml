@{
    ViewBag.Title = "Order Management";
}

<div class="row">
    <div class="col-xl">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">All Orders</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-nowrap" id="ordersTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Order ID</th>
                                <th>Product Name</th>
                                <th>Size</th>
                                <th>Qty</th>
                                <th>Username</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Notes</th>
                                <th>Order Status</th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody">
                            <!-- Data will be loaded here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadOrders();
        });

        function loadOrders() {
            $.get('@Url.Action("GetAllOrders", "OrderManagement")', function (res) {
                if (res.success) {
                    var html = '';
                    if (res.data.length === 0) {
                        html = '<tr><td colspan="14" class="text-center">No orders found.</td></tr>';
                    } else {
                        res.data.forEach(function (order, index) {
                            var products = order.items.map(i => i.productName).join('<br/>');
                            var sizes = order.items.map(i => i.size || 'N/A').join('<br/>');
                            var quantities = order.items.map(i => i.quantity).join('<br/>');
                            
                            // orderStatus Enum: 1 = Pending, 2 = InTransit, 3 = Completed, 4 = Cancelled
                            var statusDisabled = (order.statusId === 3 || order.statusId === 4) ? "disabled" : "";
                            var dropdownHtml = `
                                <select class="form-select form-select-sm" onchange="updateStatusDropdown(this, ${order.orderId})" ${statusDisabled}>
                                    <option value="1" ${order.statusId === 1 ? 'selected' : ''}>Pending</option>
                                    <option value="2" ${order.statusId === 2 ? 'selected' : ''}>In Transit</option>
                                    <option value="3" ${order.statusId === 3 ? 'selected' : ''}>Completed</option>
                                    <option value="4" ${order.statusId === 4 ? 'selected' : ''}>Cancelled</option>
                                </select>
                            `;

                            html += `<tr>
                                        <td>${index + 1}</td>
                                        <td>${order.trackingNumber}</td>
                                        <td><div style="max-height: 80px; overflow-y: auto;">${products}</div></td>
                                        <td><div style="max-height: 80px; overflow-y: auto;">${sizes}</div></td>
                                        <td><div style="max-height: 80px; overflow-y: auto;">${quantities}</div></td>
                                        <td>${order.customerName}</td>
                                        <td>${order.customerPhone}</td>
                                        <td>${order.customerEmail}</td>
                                        <td>
                                            <div style="max-height: 80px; overflow-y: auto; white-space: normal; min-width: 200px;">
                                                ${order.customerAddress}
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1" style="min-width: 250px;">
                                                <input type="text" class="form-control form-control-sm" id="note_${order.orderId}" value="${order.adminNotes}" placeholder="Add note...">
                                                <button type="button" class="btn btn-xs btn-primary w-100" onclick="updateNotes(${order.orderId})">Add</button>
                                            </div>
                                        </td>
                                        <td>
                                            ${dropdownHtml}
                                        </td>
                                     </tr>`;
                        });
                    }
                    $('#ordersTableBody').html(html);
                } else {
                    toastr.error('Failed to load orders.');
                }
            });
        }

        function updateStatusDropdown(element, orderId) {
            var newStatus = $(element).val();

            $.ajax({
                url: '@Url.Action("UpdateStatus", "OrderManagement")' + '?orderId=' + orderId + '&statusId=' + newStatus,
                type: 'POST',
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        loadOrders(); // Reload to refresh disabled state if it changed to Completed/Cancelled
                    } else {
                        toastr.error(res.message);
                        loadOrders(); // Reload to revert UI state cleanly
                    }
                },
                error: function () {
                    toastr.error('An error occurred while updating status.');
                    loadOrders(); // Reload to revert UI state cleanly
                }
            });
        }

        function updateNotes(orderId) {
            var notes = $('#note_' + orderId).val();
            $.ajax({
                url: '@Url.Action("UpdateNotes", "OrderManagement")',
                type: 'POST',
                data: { orderId: orderId, notes: notes },
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function () {
                    toastr.error('An error occurred while updating notes.');
                }
            });
        }
    </script>
}
