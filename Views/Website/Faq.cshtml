@{
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
    ViewBag.Title = "FAQ";
}

@section Styles {
    <style>
        .faq-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .faq-title {
            text-align: center;
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 40px;
            letter-spacing: 2px;
        }
        .faq-item {
            margin-bottom: 20px;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 15px;
        }
        .faq-question {
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #1f4fa3;
        }
        .faq-answer {
            margin-top: 10px;
            font-size: 15px;
            line-height: 1.6;
            color: #555;
            display: none;
        }
        .faq-question i {
            transition: transform 0.3s;
        }
        .faq-question.active i {
            transform: rotate(180deg);
        }
    </style>
}

<div class="faq-container">
    <h2 class="faq-title">FREQUENTLY ASKED QUESTIONS</h2>
    <div id="faqList">
        <!-- FAQs will be loaded here -->
        <div class="text-center text-muted" id="faqLoading">Loading FAQs...</div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadFaqs();
        });

        function loadFaqs() {
            $.get('@Url.Action("GetAllFaqs", "Website")', function (res) {
                if (res.success && res.data && res.data.length > 0) {
                    var html = res.data.map(function (faq) {
                        return `
                            <div class="faq-item">
                                <div class="faq-question" onclick="toggleFaq(this)">
                                    ${faq.question}
                                    <i class="bx bx-chevron-down"></i>
                                </div>
                                <div class="faq-answer">
                                    ${faq.answer.replace(/\n/g, '<br/>')}
                                </div>
                            </div>
                        `;
                    }).join('');
                    $('#faqList').html(html);
                } else {
                    $('#faqList').html('<div class="text-center text-muted">No FAQs found</div>');
                }
            }).fail(function () {
                $('#faqList').html('<div class="text-center text-danger">Failed to load FAQs.</div>');
            });
        }

        function toggleFaq(element) {
            var $el = $(element);
            $el.toggleClass('active');
            $el.next('.faq-answer').slideToggle();
        }
    </script>
}
