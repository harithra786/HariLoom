        function displayAddressPreview() {

            const mstUserId = sessionStorage.getItem('userId');

            if (!mstUserId) {
                return;
            }

            const url = '@Url.Action("getUserDashboardDetails", "Website")'
                + '?mstUserId=' + mstUserId;

            $.get(url, function (res) {

                if (!res || !res.success || !res.data) {
                    $('#addressPreview').html('<p style="color: #999; font-size: 14px;">Failed to load address</p>');
                    return;
                }

                const user = res.data;

                // Build address string
                let addressHtml = '';

                if (user.addressLine1) {
                    addressHtml += '<strong style="color: #111;">Shipping Address</strong><br />';
                    addressHtml += user.addressLine1 + '<br />';
                }

                if (user.addressLine2) {
                    addressHtml += user.addressLine2 + '<br />';
                }

                if (user.city || user.state || user.zipCode) {
                    let cityStateZip = '';

                    if (user.city) cityStateZip += user.city;
                    if (user.state) {
                        if (cityStateZip) cityStateZip += ', ' + user.state;
                        else cityStateZip += user.state;
                    }
                    if (user.zipCode) {
                        if (cityStateZip) cityStateZip += ' - ' + user.zipCode;
                        else cityStateZip += user.zipCode;
                    }

                    if (cityStateZip) {
                        addressHtml += cityStateZip + '<br />';
                    }
                }

                if (!addressHtml || addressHtml.trim() === '') {
                    $('#addressPreview').html('<p style="color: #999; font-size: 14px;">No address saved yet</p>');
                } else {
                    $('#addressPreview').html('<p style="color: #555; font-size: 14px; line-height: 1.8;">' + addressHtml + '</p>');
                }

            }).fail(function () {
                $('#addressPreview').html('<p style="color: #999; font-size: 14px;">Failed to load address</p>');
            });

        }

