@{
    ViewData["Title"] = "Shipping";
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
    ViewBag.HideNavigation = true;
}

<style>
    .shipping-page {
        background: #F7F4ED;
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 40px;
    }

    .shipping-container {
        max-width: 800px;
        text-align: center;
    }

    .shipping-container h1 {
        font-size: 48px;
        color: #0b1d39;
        margin-bottom: 30px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .shipping-container p {
        font-size: 18px;
        color: #333;
        line-height: 1.8;
        letter-spacing: 0.5px;
    }

    .about-content {
        max-width: 900px;
        margin: auto;
    }

        .about-content ul {
            text-align: left;
            padding-left: 25px;
        }
</style>

<div class="shipping-page">
    <div class="shipping-container">
        <h1>Shipping & Delivery</h1>
        <div class="about-content">
        <ul>
            <li>After checkout, you will receive an Order Confirmation email acknowledging that we have received your order.</li>

            <li>Once your order has been confirmed and dispatched, a separate shipping confirmation email with tracking details will be sent.</li>

            <li>Orders are typically processed and dispatched within 7 business days.</li>

            <li>For domestic orders within India, we ship through Shiprocket, Blue Dart, and other trusted courier partners.</li>

            <li>For any queries, contact us at <a href="mailto:contact@hariloom.com">contact@hariloom.com</a> or reach out via Instagram.</li>
        </ul>
        </div>
    </div>
</div>
