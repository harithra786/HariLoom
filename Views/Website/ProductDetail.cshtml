@{
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
    ViewBag.Title = "Product Detail";
}

@section Styles {
    <style>
        .product-card { cursor: pointer; }
        .product-card img { width: 100%; height: clamp(250px, 35vw, 420px); object-fit: cover; }

        /* PRODUCT SECTION */
        .product-section {
            display: flex;
            gap: clamp(20px, 4vw, 40px);
            margin-top: clamp(15px, 3vw, 30px);
            flex-wrap: wrap;
        }

        /* IMAGES */
        .product-images {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: clamp(10px, 2vw, 20px);
            flex: 2 1 500px;
            min-width: 0;
        }
        .product-images img {
            width: 100%;
            height: auto;
            object-fit: cover;
            border-radius: 6px;
        }

        /* DETAILS */
        .product-details { 
            flex: 1 1 350px; 
            min-width: 300px; 
            max-width: 450px;
            position: sticky;
            top: 120px;
            align-self: flex-start;
        }
        .product-details h2 { margin: 0; font-size: clamp(18px, 3vw, 22px); color: black; }

        .price { font-size: clamp(16px, 2.5vw, 18px); margin: 10px 0; color: black; }

        /* SIZES */
        .sizes { margin: 15px 0; display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
        .size {
            border: 1px solid #ccc; padding: 6px 12px;
            cursor: pointer; font-size: 14px; display: inline-block;
        }
        .size.active { border-color: black; font-weight: bold; }
        .size.out-of-stock { 
            color: #a0a0a0; 
            border-color: #e0e0e0; 
            text-decoration: none;
            background: linear-gradient(to top right, #f9f9f9 calc(50% - 1px), #a0a0a0 calc(50%), #f9f9f9 calc(50% + 1px));
        }
        .sizes a { margin-left: 10px; font-size: 12px; text-decoration: none; color: #1f4fa3; font-weight: 600; }
        .sizes a:hover { text-decoration: underline; }

        /* BUTTONS */
        .buyNowBtn {
            width: 100%; padding: 12px; margin-top: 10px;
            cursor: pointer; border-radius: 4px; font-size: clamp(13px, 1.5vw, 15px);
        }
        .buyNowBtn.outline { border: 1px solid #ccc; background: #f5f5f5; }
        .buyNowBtn.primary { background: #0d47a1; color: white; border: none; }

        /* ACCORDION */
        .details-wrapper { margin-top: 20px; }
        .details-wrapper .item { border-top: 1px solid #ddd; }
        .details-wrapper .header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 0; cursor: pointer; font-size: 14px; color: black;
        }
        .details-wrapper .icon { font-size: 18px; font-weight: bold; }
        .details-wrapper .content {
            max-height: 0; overflow: hidden; transition: all 0.3s ease;
            font-size: 13px; color: #555; line-height: 1.6;
        }
        .details-wrapper .item.active .content { max-height: 500px; padding-bottom: 10px; }

        /* SIMILAR PRODUCTS */
        .similar { margin-top: clamp(20px, 4vw, 40px); }
        .similar h3 { font-size: clamp(14px, 2vw, 16px); margin-bottom: 20px; }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 25vw, 200px), 1fr));
            gap: clamp(10px, 2vw, 20px);
        }

        .card { width: 100%; }
        .card img { width: 100%; border-radius: 6px; }
        .card p { margin: 5px 0; font-size: clamp(12px, 1.5vw, 14px); }
        .card span { font-size: clamp(11px, 1.3vw, 13px); }

        .discover { text-align: center; margin-top: 20px; }
        .discover button { padding: 10px 20px; border: none; background: #eee; cursor: pointer; }

        .product-price { font-size: 14px; margin-top: 5px; font-weight: 500; }
        .old-price { text-decoration: line-through; color: #999; margin-left: 8px; font-size: 13px; }

        /* SIZE GUIDE MODAL */
        .size-guide-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.6);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .size-guide-modal {
            position: relative;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            max-width: 90vw;
            max-height: 90vh;
            overflow: auto;
            text-align: center;
        }
        .size-guide-modal img {
            max-width: 100%;
            max-height: 75vh;
            width: auto;
            height: auto;
            display: block;
            margin: 15px auto 0;
            object-fit: contain;
        }
        .size-guide-close {
            position: absolute;
            top: 5px;
            right: 15px;
            font-size: 28px;
            cursor: pointer;
            color: #333;
            font-weight: bold;
            line-height: 1;
        }

        /* Tablet landscape (iPad ~1024px) */
        @@media (max-width: 1024px) {
            .product-section {
                flex-direction: column;
            }
            .product-images {
                flex: 1 1 auto;
                width: 100%;
            }
            .product-details {
                flex: 1 1 auto;
                width: 100%;
                max-width: 100%;
                position: static;
            }
            .product-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            }
        }

        /* Tablet portrait & large phones */
        @@media (max-width: 768px) {
            .product-section {
                flex-direction: column;
                gap: 20px;
            }
            .product-images {
                display: flex;
                flex-direction: row;
                overflow-x: auto;
                gap: 10px;
            }
            .product-images img {
                width: 70%;
                flex: 0 0 auto;
            }
            .product-details {
                width: 100%;
            }
            .buyNowBtn {
                font-size: 14px;
                padding: 14px;
            }
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }
        }

        /* Small phones */
        @@media (max-width: 480px) {
            .product-images {
                flex-direction: column;
            }
            .product-images img {
                width: 100%;
                max-width: 100%;
            }
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
            }
            .sizes { gap: 4px; }
            .size { padding: 5px 10px; font-size: 13px; }
        }
    </style>
}

<div class="product-section">
    <div class="product-images">
    </div>
    <div class="product-details">
        <h2></h2>
        <p class="price"></p>
        <div class="sizes">
            <a href="#" class="size-guide-link">SIZE GUIDE</a>
        </div>
        <div class="quantity" style="margin-top:10px; display:flex; gap:8px; align-items:center;">
            <label style="font-size:14px; margin-right:6px;">Quantity</label>
            <button type="button" id="qtyMinus" class="btn outline" style="padding:6px 10px;">-</button>
            <input id="qtyInput" type="number" min="1" value="1" style="width:60px; text-align:center; padding:6px;" />
            <button type="button" id="qtyPlus" class="btn outline" style="padding:6px 10px;">+</button>
        </div>
        <button id="btnAddToBag" class="btn outline buyNowBtn">ADD TO BAG</button>
        <button id="btnBuyNow" class="btn primary buyNowBtn">BUY NOW</button>
        <div class="details-wrapper">
        </div>
    </div>
</div>

<div class="similar">
    <h3>SIMILAR PRODUCTS</h3>
    <div class="product-grid" id="similarProductsGrid">
    </div>
    @* <div class="discover">
        <button>DISCOVER MORE</button>
    </div> *@
</div>

<div class="size-guide-overlay" id="sizeGuideOverlay">
    <div class="size-guide-modal">
        <span class="size-guide-close" id="sizeGuideClose">&times;</span>
        <img src="@Url.Content("~/images/Hariloom.webp")" alt="Size Guide" />
    </div>
</div>

@section Scripts {
    <script>
        const userId = sessionStorage.getItem('userId');
        let currentQuantityAvailable = 20;

        $(function () {
            loadProductDetails();
            loadSimilarProducts();

            $('#qtyPlus').click(() => {
                let qty = parseInt($('#qtyInput').val());
                let maxAllowed = Math.min(20, currentQuantityAvailable);
                if (qty < maxAllowed) {
                    $('#qtyInput').val(qty + 1);
                } else {
                    if (qty >= currentQuantityAvailable) {
                        alert(`Only ${currentQuantityAvailable} items available in stock.`);
                    } else {
                        alert('You cannot order more than 20 items per dress.');
                    }
                }
            });

            $('#qtyMinus').click(() => {
                let qty = parseInt($('#qtyInput').val());
                $('#qtyInput').val(qty > 1 ? qty - 1 : 1);
            });

            $('#qtyInput').on('input', function() {
                let val = parseInt($(this).val());
                let maxAllowed = Math.min(20, currentQuantityAvailable);
                if (val > maxAllowed) {
                    $(this).val(maxAllowed);
                    if (val > currentQuantityAvailable) {
                        alert(`Only ${currentQuantityAvailable} items available in stock.`);
                    } else {
                        alert('You cannot order more than 20 items per dress.');
                    }
                } else if (val < 1 || isNaN(val)) {
                    $(this).val(1);
                }
            });

            $(document).on('click', '.size', function () {
                $('.size').removeClass('active');
                $(this).addClass('active');
                currentQuantityAvailable = parseInt($(this).attr('data-qty')) || 0;
                
                let val = parseInt($('#qtyInput').val());
                let maxAllowed = Math.min(20, currentQuantityAvailable);
                
                if (currentQuantityAvailable <= 0) {
                    $('#btnAddToBag').prop('disabled', true).text('OUT OF STOCK').css({'opacity': '0.5', 'cursor': 'not-allowed'});
                    $('#btnBuyNow').prop('disabled', true).css({'opacity': '0.5', 'cursor': 'not-allowed'});
                    $('#qtyInput').val(0).prop('disabled', true);
                    $('#qtyPlus, #qtyMinus').prop('disabled', true).css({'opacity': '0.5', 'cursor': 'not-allowed'});
                } else {
                    $('#btnAddToBag').prop('disabled', false).text('ADD TO BAG').css({'opacity': '1', 'cursor': 'pointer'});
                    $('#btnBuyNow').prop('disabled', false).css({'opacity': '1', 'cursor': 'pointer'});
                    $('#qtyInput').prop('disabled', false);
                    $('#qtyPlus, #qtyMinus').prop('disabled', false).css({'opacity': '1', 'cursor': 'pointer'});
                    
                    if (val > maxAllowed) {
                        $('#qtyInput').val(maxAllowed);
                    } else if (val < 1) {
                        $('#qtyInput').val(1);
                    }
                }
            });

            $(document).on('click', '.header', function () {
                const parent = $(this).parent();
                const isActive = parent.hasClass('active');

                // Collapse all
                $('.item').removeClass('active');
                $('.toggle-icon').text('+');

                // Expand clicked if it was not already active
                if (!isActive) {
                    parent.addClass('active');
                    $(this).find('.toggle-icon').text('-');
                }
            });

            // Size Guide Modal
            $(document).on('click', '.size-guide-link', function(e) {
                e.preventDefault();
                $('#sizeGuideOverlay').css('display', 'flex');
            });
            $('#sizeGuideClose, #sizeGuideOverlay').on('click', function(e) {
                if (e.target.id === 'sizeGuideOverlay' || e.target.id === 'sizeGuideClose') {
                    $('#sizeGuideOverlay').hide();
                }
            });
        });

        function loadSimilarProducts() {
            $.ajax({
                url: '@Url.Action("GetAllProductDetails", "ProductsManagement")',
                type: 'GET',
                success: function (res) {
                    if (!res.data) {
                        $('#similarProductsGrid').hide();
                        return;
                    }

                    // Filter only active and available products
                    var items = res.data.filter(p => p.isActive && p.isAvailable);

                    let html = '';
                    const fallback = "data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22100%25%22%20height%3D%22100%25%22%20viewBox%3D%220%200%20800%20800%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20fill%3D%22%23e9ecef%22%20%2F%3E%3Ctext%20x%3D%2250%25%22%20y%3D%2250%25%22%20fill%3D%22%23adb5bd%22%20font-family%3D%22sans-serif%22%20font-size%3D%2240%22%20text-anchor%3D%22middle%22%20dy%3D%22.3em%22%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E";

                    items.forEach(item => {
                        const selling = (item.basePrice || 0) - (item.discountedPrice || 0);

                        html += `<div class="product-card" onclick="fnGoToProductDetails(${item.productId})">
                            <img src="${item.coverImagePath ? '/' + item.coverImagePath : fallback}" />
                            <p>${item.productName}</p>
                            <p class="product-price">
                                ₹${selling}
                                ${item.discountedPrice > 0
                                    ? `<span class="old-price">₹${item.basePrice}</span>`
                                    : ''}
                            </p>
                        </div>`;
                    });
                    $('#similarProductsGrid').html(html);
                },
                error: function () {
                    console.log('Failed to load similar products');
                }
            });
        }

        function loadProductDetails() {
            const id = sessionStorage.getItem('selectedProductId');

            $.ajax({
                url: '@Url.Action("GetProductById", "ProductsManagement")',
                type: 'GET',
                data: { id: id },
                success: function (res) {
                    if (!res.data) {
                        return;
                    }

                    const p = res.data;

                    const selling = (p.basePrice || 0) - (p.discountedPrice || 0);
                    $('.product-details h2').text(p.productName);
                    $('.price').html(`₹${selling} ${p.discountedPrice > 0 ? `<span class="old-price">₹${p.basePrice}</span>` : ''}`);
                    const fallback = "data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22100%25%22%20height%3D%22100%25%22%20viewBox%3D%220%200%20800%20800%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20fill%3D%22%23e9ecef%22%20%2F%3E%3Ctext%20x%3D%2250%25%22%20y%3D%2250%25%22%20fill%3D%22%23adb5bd%22%20font-family%3D%22sans-serif%22%20font-size%3D%2240%22%20text-anchor%3D%22middle%22%20dy%3D%22.3em%22%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E";
                    
                    let imagesHtml = '';
                    if (p.productImages && p.productImages.length > 0) {
                        p.productImages.forEach(img => {
                            if (img && img !== p.coverImagePath) {
                                imagesHtml += `<img src="/${img}" />`;
                            }
                        });
                    }
                    if (imagesHtml === '') {
                        imagesHtml = `<img src="${fallback}" />`;
                    }
                    $('.product-images').html(imagesHtml);

                    let sizeHtml = '';
                    p.sizes?.forEach((s, i) => {
                        let outOfStockClass = (s.quantityAvailable <= 0) ? ' out-of-stock' : '';
                        sizeHtml += `<span class="size ${i === 0 ? 'active' : ''}${outOfStockClass}" data-qty="${s.quantityAvailable}"> ${s.size} </span>`;
                        if (i === 0) {
                            currentQuantityAvailable = s.quantityAvailable || 0;
                        }
                    });
                    sizeHtml += `<a href="#" class="size-guide-link">SIZE GUIDE</a>`;
                    $('.sizes').html(sizeHtml);

                    if (currentQuantityAvailable <= 0) {
                        $('#btnAddToBag').prop('disabled', true).text('OUT OF STOCK').css({'opacity': '0.5', 'cursor': 'not-allowed'});
                        $('#btnBuyNow').prop('disabled', true).css({'opacity': '0.5', 'cursor': 'not-allowed'});
                        $('#qtyInput').val(0).prop('disabled', true);
                        $('#qtyPlus, #qtyMinus').prop('disabled', true).css({'opacity': '0.5', 'cursor': 'not-allowed'});
                    } else {
                        $('#btnAddToBag').prop('disabled', false).text('ADD TO BAG').css({'opacity': '1', 'cursor': 'pointer'});
                        $('#btnBuyNow').prop('disabled', false).css({'opacity': '1', 'cursor': 'pointer'});
                        $('#qtyInput').val(1).prop('disabled', false);
                        $('#qtyPlus, #qtyMinus').prop('disabled', false).css({'opacity': '1', 'cursor': 'pointer'});
                    }

                    // Description item (shows below the buttons)
                    const descriptionText = p.description || p.productDescription || p.productDesc || p.descriptionHtml || '';
                    let specHtml = '';
                    specHtml += `<div class="item">
                            <div class="header">
                                <span>Description</span>
                                <span class="toggle-icon">+</span>
                            </div>
                            <div class="content description-content">
                                ${descriptionText ? `<p>${descriptionText}</p>` : '<p>No description available.</p>'}
                            </div>
                        </div>`;

                    p.specifications?.forEach(spec => {
                        specHtml += `<div class="item">
                            <div class="header">
                                <span>${spec.title}</span>
                                <span class="toggle-icon">+</span>
                            </div>
                            <div class="content">
                                <p>${spec.value}</p>
                            </div>
                        </div>`;
                    });

                    if (p.washCares && p.washCares.length > 0) {
                        let wcContent = '<ul style="padding-left: 20px;">';
                        p.washCares.forEach(wc => {
                            wcContent += `<li style="list-style-type: disc; margin-bottom: 5px;">${wc.instruction}</li>`;
                        });
                        wcContent += '</ul>';

                        specHtml += `<div class="item">
                            <div class="header">
                                <span>Wash Care</span>
                                <span class="toggle-icon">+</span>
                            </div>
                            <div class="content">
                                ${wcContent}
                            </div>
                        </div>`;
                    }

                    $('.details-wrapper').html(specHtml);
                    $('#btnAddToBag').off().click(function () {
                        addToBag(p);
                    });
                    $('#btnBuyNow').off().click(function () {
                        buyNow(p);
                    });
                },
                error: function () {
                    console.log('Failed to load product details');
                }
            });
        }

        function addToBag(product) {
            if (!userId) {
                $("#loginPromptModal").modal("show");
                return;
            }

            const payload = {
                productId: product.productId,
                size: $('.size.active').text().trim(),
                quantity: parseInt($('#qtyInput').val()),
                userId: parseInt(sessionStorage.getItem('userId'))
            };

            $.ajax({
                url: '@Url.Action("AddToBag", "Website")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        alert("Product successfully added to your bag!");
                    } else {
                        alert(res.message || "Failed to add product to your bag.");
                    }
                },
                error: function () {
                    alert("An error occurred while adding to bag.");
                }
            });
        }

        function buyNow(product) {
            if (!userId) {
                $("#loginPromptModal").modal("show");
                return;
            }

            const selling = (product.basePrice || 0) - (product.discountedPrice || 0);

            const quantity = $('#qtyInput').val() || 1;

            const url = '@Url.Action("BuyNow", "Website")'
                + '?mstProductId=' + encodeURIComponent(product.productId)
                + '&size=' + encodeURIComponent($('.size.active').text().trim() || 'M')
                + '&quantity=' + encodeURIComponent(quantity)
                + '&price=' + encodeURIComponent(selling)
                + '&productName=' + encodeURIComponent(product.productName);

            window.location.href = url;
        }
    </script>
}
