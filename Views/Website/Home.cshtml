@{
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
    ViewBag.Title = "Home";
    ViewBag.IsHome = true;
}

@section Styles {
    <style>
        body {
            background: #f6d5ea;
        }

        .hero-section {
            width: 100%;
            position: relative;
            overflow: hidden;
            height: auto;
        }

        .hero-image {
            width: 100%;
            height: auto;
            display: block;
            z-index: 0;
        }


        .hero-text {
            position: absolute;
            top: 80%;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 clamp(15px, 4vw, 40px);
            font-size: clamp(28px, 8vw, 100px);
            font-weight: 700;
            letter-spacing: clamp(2px, 1vw, 8px);
            color: #0b1d39;
            opacity: 0;
            transform: translateY(80px);
            transition: .5s ease;
        }

            .hero-text.show {
                opacity: 1;
                transform: translateY(-50%);
            }

            .hero-text.hide {
                opacity: 0;
                transform: translateY(-60%);
            }

            .hero-text .center {
                color: transparent;
                -webkit-text-stroke: 2px rgba(255,255,255,0.98);
                -webkit-text-fill-color: transparent;
            }

        .collection-section {
            width: 100%;
            max-width: 100%;
            padding: 40px 40px 80px;
            background: #f6d5ea;
        }

        .collection-title {
            text-align: center;
            font-size: clamp(16px, 3vw, 22px);
            letter-spacing: 2px;
            margin-bottom: clamp(20px, 4vw, 40px);
            font-weight: 600;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 30px;
            width: 100%;
        }

        .product-card {
            position: relative;
            cursor: pointer;
        }

            .product-card img {
                width: 100%;
                height: auto;
                display: block;
                object-fit: contain;
            }

        .product-card {
            position: relative;
            width: 100%;
        }

        .product-info {
            margin-top: 10px;
        }

        .product-name {
            font-size: clamp(11px, 1.5vw, 13px);
            letter-spacing: 1px;
        }

        .product-price {
            font-size: clamp(12px, 1.5vw, 14px);
            font-weight: 500;
            margin-top: 5px;
        }

        .old-price {
            margin-left: 8px;
            font-size: clamp(11px, 1.3vw, 13px);
            color: #999;
            text-decoration: line-through;
        }

        .explore-btn-wrap {
            display: flex;
            justify-content: center;
            margin-top: clamp(20px, 4vw, 40px);
        }

        .explore-btn {
            padding: clamp(8px, 1.5vw, 12px) clamp(20px, 3vw, 30px);
            border: none;
            background: #e5e5e5;
            cursor: pointer;
            transition: .3s;
        }

            .explore-btn:hover {
                background: #d5d5d5;
            }

        /* Tablet */
        @@media (max-width: 1024px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Mobile */
        @@media (max-width: 768px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .hero-section {
                height: auto;
                display: block;
            }

            .hero-image {
                position: static;
                transform: none;
                width: 100%;
                height: auto;
            }
        }

        /* Small phones */
        @@media (max-width: 480px) {
            .collection-section {
                padding: 20px 10px;
            }
        }

        /* Scroll Transition */
        .fade-in-up {
            opacity: 0;
            transform: translateY(60px);
            transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }

            .fade-in-up.visible {
                opacity: 1;
                transform: translateY(0);
            }

        /* Scroll Progress Bar */
        .scroll-progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 4px;
            background: linear-gradient(90deg, #6b21a8, #a855f7, #c084fc);
            width: 0%;
            z-index: 10001;
            transition: width 0.1s ease-out;
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.8);
        }

        /* Hero Floating Badge */
        .hero-section {
            position: relative;
            z-index: 1;
        }


        /* Glassmorphism Product/Category Card */
        .product-card {
            position: relative;
            cursor: pointer;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.68);
            backdrop-filter: blur(12px);
            padding: 14px;
            border: 1px solid rgba(255, 255, 255, 0.85);
            box-shadow: 0 8px 24px rgba(0,0,0,0.04);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, border-color 0.4s ease;
        }
        .product-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 45px rgba(107, 33, 168, 0.16);
            border-color: rgba(168, 85, 247, 0.5);
        }

        /* Cursor Sparkle Comet Trail */
        .cursor-trail-sparkle {
            position: fixed;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #c084fc;
            box-shadow: 0 0 10px #a855f7, 0 0 20px #e9d5ff;
            pointer-events: none;
            z-index: 9999;
            animation: trailFade 0.55s ease-out forwards;
        }
        @@keyframes trailFade {
            0% { opacity: 1; transform: scale(1) translateY(0); }
            100% { opacity: 0; transform: scale(0.2) translateY(-15px); }
        }

        /* Background Animated Container for Home Page */
        .home-bg-animation-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        /* Tiny Dark Purple Floating Balls (Refined Micro Size) */
        .tiny-purple-ball {
            position: absolute;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #4c1d95;
            box-shadow: 0 0 4px rgba(91, 33, 182, 0.7), 0 0 2px rgba(126, 34, 206, 0.8);
            opacity: 0.7;
            will-change: transform, opacity, box-shadow, background;
            transition: transform 0.25s ease-out, opacity 0.25s ease-out, box-shadow 0.25s ease-out, background 0.25s ease-out;
            animation: floatTinyBall 14s ease-in-out infinite alternate;
        }

        /* When cursor passes near: SHINE ONLY (no size increase) */
        .tiny-purple-ball.twinkling {
            opacity: 1;
            background: #ffffff;
            box-shadow: 0 0 12px #c084fc, 0 0 24px #a855f7, 0 0 36px #e9d5ff, 0 0 6px #ffffff;
            animation: shinePulse 0.45s ease-in-out infinite alternate !important;
        }

        @@keyframes shinePulse {
            0% {
                background: #c084fc;
                box-shadow: 0 0 8px #a855f7, 0 0 16px #c084fc;
                filter: brightness(1.3);
            }
            100% {
                background: #ffffff;
                box-shadow: 0 0 16px #d8b4fe, 0 0 32px #a855f7, 0 0 48px #e9d5ff, 0 0 8px #ffffff;
                filter: brightness(2.8);
            }
        }

        @@keyframes floatTinyBall {
            0% {
                transform: translate(0, 0);
            }
            50% {
                transform: translate(8px, -10px);
            }
            100% {
                transform: translate(-8px, 8px);
            }
        }

    </style>
}

<!-- Scroll Progress Bar -->
<div id="scrollProgressBar" class="scroll-progress-bar"></div>

<!-- Background Floating Tiny Dark Purple Balls Container (Home Page Only) -->
<div class="home-bg-animation-container" id="tinyBallsContainer" aria-hidden="true"></div>

<div class="hero-section">
    <img class="hero-image" src="@Url.Content("~/images/Home.webp")" alt="Home Banner" />
</div>

<div id="summer-collection" class="collection-section" style="scroll-margin-top:130px;">
    <!-- Breadcrumb / Back button -->
    <div style="max-width: 1120px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px;">
        <button id="category-back-btn" class="explore-btn" style="display: none; border-radius: 8px; font-weight: 600; font-size: 14px; padding: 8px 16px;" onclick="fnGoBackCategory()">
            <i class="bx bx-left-arrow-alt" style="font-size: 18px; vertical-align: middle; margin-right: 4px;"></i> Back
        </button>
        <div id="category-breadcrumb" style="font-size: 14px; font-weight: 500;">
            <span style="color: #333; font-weight: 600;">Categories</span>
        </div>
    </div>

    <h2 class="collection-title" id="section-title">SHOP BY CATEGORY</h2>
    <div class="product-grid"></div>
</div>



@section Scripts {
    <script>
        const productGrid = $('.product-grid');
        const userId = parseInt(sessionStorage.getItem('userId'));

        // Generate Poisson-disc random yet uniformly spaced tiny floating dark purple balls for Home Page
        function initHomeBackgroundAnimations() {
            const container = $('#tinyBallsContainer');
            if (container.length) {
                container.empty();
                const balls = [];
                const targetCount = 38;
                const minDist = 11.8; // Minimum distance % between any two balls to prevent crowding

                let attempts = 0;
                while (balls.length < targetCount && attempts < 2000) {
                    attempts++;
                    const candidateTop = Math.random() * 90 + 4;
                    const candidateLeft = Math.random() * 92 + 4;

                    let valid = true;
                    for (let i = 0; i < balls.length; i++) {
                        const dTop = candidateTop - balls[i].top;
                        const dLeft = candidateLeft - balls[i].left;
                        if (Math.hypot(dTop, dLeft) < minDist) {
                            valid = false;
                            break;
                        }
                    }

                    if (valid) {
                        balls.push({ top: candidateTop, left: candidateLeft });
                    }
                }

                balls.forEach(b => {
                    const dur = (Math.random() * 6 + 12).toFixed(1);
                    const delay = (-(Math.random() * 12)).toFixed(1);

                    const ball = $(`<div class="tiny-purple-ball" style="
                        top: ${b.top.toFixed(1)}%;
                        left: ${b.left.toFixed(1)}%;
                        animation-duration: ${dur}s;
                        animation-delay: ${delay}s;
                    "></div>`);
                    container.append(ball);
                });
            }
        }

        $(document).ready(function () {
            initHomeBackgroundAnimations();
        });

        // Interactive Proximity Twinkle for Mobile Touch & Desktop Mouse (Home Page Only)
        $(document).on('mousemove pointermove touchmove touchstart', function (e) {
            if (typeof getEventCoords !== 'function') return;
            const coords = getEventCoords(e);
            if (coords.x === undefined || coords.y === undefined) return;

            const mouseX = coords.x;
            const mouseY = coords.y;

            $('.tiny-purple-ball').each(function () {
                const rect = this.getBoundingClientRect();
                const ballCenterX = rect.left + rect.width / 2;
                const ballCenterY = rect.top + rect.height / 2;

                const dist = Math.hypot(mouseX - ballCenterX, mouseY - ballCenterY);

                if (dist < 140) {
                    $(this).addClass('twinkling');
                } else {
                    $(this).removeClass('twinkling');
                }
            });
        });



        // Hero animation
        $(window).on('scroll', () => {
            const scrollTop = $(window).scrollTop();
            const heroHeight = $('.hero-section').height();
            $('.hero-text').toggleClass('show', scrollTop > heroHeight * 0.1 && scrollTop < heroHeight * 0.6).toggleClass('hide', scrollTop >= heroHeight * 0.6);
        });

        // Wishlist Toggle
        function toggleWishlist(e, productId) {
            e.preventDefault();
            e.stopPropagation();

            if (!userId) {
                $("#loginPromptModal").modal("show");
                return;
            }

            const button = $(e.currentTarget);
            const isActive = button.hasClass('active');

            $.ajax({
                url: '@Url.Action("addToWishlist", "Website")'.replace('addToWishlist', isActive ? 'removeFromWishlist' : 'addToWishlist'),
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    mstUserId: userId,
                    mstProductId: productId
                }),
                success: res => {
                           if (res.success) {
            button.toggleClass('active');

            const icon = button.find('.wishlist-icon');

            if (button.hasClass('active')) {
                icon.attr('src', '/images/heart-filled.webp');
            } else {
                icon.attr('src', '/images/heart-outline.webp');
            }

            if (isActive) {
                toastr.info('Removed from wishlist');
            } else {
                toastr.success('Added to wishlist');
            }
        }
                }
            });
        }

        let currentView = 'main';
        let selectedMainCategoryId = null;
        let selectedMainCategoryName = '';
        let selectedSubCategoryId = null;
        let selectedSubCategoryName = '';

        // Load Main Categories
        function loadMainCategories() {
            currentView = 'main';
            $('#category-back-btn').hide();
            $('#section-title').text('SHOP BY CATEGORY');
            $('#category-breadcrumb').html('<span style="color: #333; font-weight: 600;">Categories</span>');
            
            productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 18px; color: #666;"><i class="bx bx-loader-alt bx-spin" style="font-size: 32px; margin-bottom: 10px; display: block;"></i>Loading categories...</div>');

            $.get('@Url.Action("GetAllActiveProductMainCategories", "ProductsManagement")', function (res) {
                let items = [];
                if (res && res.success && Array.isArray(res.data)) items = res.data;
                else if (res && Array.isArray(res.data)) items = res.data;
                else if (Array.isArray(res)) items = res;

                items = items.filter(function (p) { return p.isActive !== false && p.IsActive !== false; });

                if (!items.length) {
                    productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 16px; color: #666;">No categories found</div>');
                    return;
                }

                let html = items.map(function (cat, index) {
                    let imgSrc = cat.mainCategoryImagePath 
                        ? (cat.mainCategoryImagePath.startsWith('data:') || cat.mainCategoryImagePath.startsWith('/') || cat.mainCategoryImagePath.startsWith('images/') || cat.mainCategoryImagePath.startsWith('http')
                            ? (cat.mainCategoryImagePath.startsWith('/') ? cat.mainCategoryImagePath : '/' + cat.mainCategoryImagePath)
                            : 'data:image/webp;base64,' + cat.mainCategoryImagePath) 
                        : '/images/placeholder.webp';

                    let delay = (index % 3) * 0.15;

                    return `<div class="product-card fade-in-up" style="transition-delay: ${delay}s;" onclick="fnLoadSubCategories(${cat.mstProductMainCategoryId}, '${cat.mainCategoryName}')">
                                <div style="position: relative; width: 100%; padding-top: 120%; border-radius: 12px; overflow: hidden; background: #eaeaea; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                                    <img src="${imgSrc}" onerror="this.onerror=null; this.src='/images/placeholder.webp';" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
                                </div>
                                <div class="product-info" style="text-align:center; padding: 12px 5px 0;">
                                    <p class="product-name" style="font-weight: 600; font-size: clamp(14px, 2vw, 17px); letter-spacing: 1px; color: #222; text-transform: uppercase;">${cat.mainCategoryName}</p>
                                </div>
                            </div>`;
                }).join('');

                productGrid.html(html);
                initializeObserver();
            }).fail(function (err) {
                console.error('Failed to load main categories', err);
                productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 16px; color: #ff3333;">Failed to load categories. Please try again.</div>');
            });
        }

        // Load Sub Categories
        function fnLoadSubCategories(mainCategoryId, mainCategoryName) {
            currentView = 'sub';
            selectedMainCategoryId = mainCategoryId;
            selectedMainCategoryName = mainCategoryName;

            $('#category-back-btn').show();
            $('#section-title').text(mainCategoryName.toUpperCase());
            $('#category-breadcrumb').html(`
                <a href="javascript:void(0);" onclick="loadMainCategories()" style="color: #1f4fa3; text-decoration: none; font-weight: 500;">Categories</a>
                <span style="color: #888; margin: 0 6px;">&gt;</span>
                <span style="color: #333; font-weight: 600;">${mainCategoryName}</span>
            `);

            productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 18px; color: #666;"><i class="bx bx-loader-alt bx-spin" style="font-size: 32px; margin-bottom: 10px; display: block;"></i>Loading subcategories...</div>');

            $.get('@Url.Action("GetAllActiveSubCategoryByIDWithImage", "ProductsManagement")', { id: mainCategoryId }, function (res) {
                let items = [];
                if (res && res.success && Array.isArray(res.data)) items = res.data;
                else if (res && Array.isArray(res.data)) items = res.data;
                else if (Array.isArray(res)) items = res;

                items = items.filter(function (p) { return p.isActive !== false && p.IsActive !== false; });

                if (!items.length) {
                    productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 16px; color: #666;">No subcategories found in this category</div>');
                    return;
                }

                let html = items.map(function (sub, index) {
                    let imgSrc = sub.subCategoryImagePath 
                        ? (sub.subCategoryImagePath.startsWith('data:') || sub.subCategoryImagePath.startsWith('/') || sub.subCategoryImagePath.startsWith('images/') || sub.subCategoryImagePath.startsWith('http')
                            ? (sub.subCategoryImagePath.startsWith('/') ? sub.subCategoryImagePath : '/' + sub.subCategoryImagePath)
                            : 'data:image/webp;base64,' + sub.subCategoryImagePath) 
                        : '/images/placeholder.webp';

                    let delay = (index % 3) * 0.15;

                    return `<div class="product-card fade-in-up" style="transition-delay: ${delay}s;" onclick="fnLoadProducts(${sub.mstProductSubCategoryId}, '${sub.subCategoryName}')">
                                <div style="position: relative; width: 100%; padding-top: 120%; border-radius: 12px; overflow: hidden; background: #eaeaea; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                                    <img src="${imgSrc}" onerror="this.onerror=null; this.src='/images/placeholder.webp';" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
                                </div>
                                <div class="product-info" style="text-align:center; padding: 12px 5px 0;">
                                    <p class="product-name" style="font-weight: 600; font-size: clamp(13px, 1.8vw, 16px); letter-spacing: 1px; color: #222; text-transform: uppercase;">${sub.subCategoryName}</p>
                                </div>
                            </div>`;
                }).join('');

                productGrid.html(html);
                initializeObserver();
            }).fail(function (err) {
                console.error('Failed to load subcategories', err);
                productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 16px; color: #ff3333;">Failed to load subcategories.</div>');
            });
        }

        // Load Products by Sub Category
        function fnLoadProducts(subCategoryId, subCategoryName) {
            currentView = 'products';
            selectedSubCategoryId = subCategoryId;
            selectedSubCategoryName = subCategoryName;

            $('#category-back-btn').show();
            $('#section-title').text(subCategoryName.toUpperCase());
            $('#category-breadcrumb').html(`
                <a href="javascript:void(0);" onclick="loadMainCategories()" style="color: #1f4fa3; text-decoration: none; font-weight: 500;">Categories</a>
                <span style="color: #888; margin: 0 6px;">&gt;</span>
                <a href="javascript:void(0);" onclick="fnLoadSubCategories(${selectedMainCategoryId}, '${selectedMainCategoryName}')" style="color: #1f4fa3; text-decoration: none; font-weight: 500;">${selectedMainCategoryName}</a>
                <span style="color: #888; margin: 0 6px;">&gt;</span>
                <span style="color: #333; font-weight: 600;">${subCategoryName}</span>
            `);

            productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 18px; color: #666;"><i class="bx bx-loader-alt bx-spin" style="font-size: 32px; margin-bottom: 10px; display: block;"></i>Loading products...</div>');

            $.get('/ProductsManagement/GetActiveProductsBySubCategoryId', { subCategoryId: subCategoryId }, function (res) {
                let items = [];
                if (res && res.success && Array.isArray(res.data)) items = res.data;
                else if (res && Array.isArray(res.data)) items = res.data;
                else if (Array.isArray(res)) items = res;

                items = items.filter(function (p) { return p.isActive !== false; });

                if (!items.length) {
                    productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 16px; color: #666;">No products found in this subcategory</div>');
                    return;
                }

                let html = items.map(function (item, index) {
                    let sellingPrice = Math.max(0, (item.basePrice || 0) - (item.discountedPrice || 0));
                    let priceHtml = item.discountedPrice > 0
                        ? `<p class="product-price"> ₹ ${sellingPrice} <span class="old-price">₹ ${item.basePrice}</span></p>`
                        : `<p class="product-price">₹ ${item.basePrice}</p>`;

                    let coverUrl = item.coverImagePath
                        ? (item.coverImagePath.startsWith('/') ? item.coverImagePath : '/' + item.coverImagePath)
                        : '/images/placeholder.webp';

                    let imgHtml = `<img src="${coverUrl}" onerror="this.onerror=null; this.src='/images/placeholder.webp';" style="width:100%; height:auto; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'" />`;

                    let delay = (index % 3) * 0.15;

                    return `<div class="product-card fade-in-up" style="transition-delay: ${delay}s;" onclick="fnGoToProductDetails(${item.productId})">
                                <div style="position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: #eaeaea; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                                    ${imgHtml}
                                </div>
                                <div class="product-info" style="padding: 10px 5px 0;">
                                    <p class="product-name" style="font-weight: 500; font-size: clamp(12px, 1.6vw, 14px); color: #333; margin-bottom: 2px;">${item.productName || ''}</p>
                                    ${priceHtml}
                                </div>
                                <button class="wishlist-heart" onclick="toggleWishlist(event, ${item.productId})" data-id="${item.productId}">
                                    <img class="wishlist-icon" src="/images/heart-outline.webp" alt="Wishlist" style="width:22px;height:22px;">
                                </button>
                            </div>`;
                }).join('');

                productGrid.html(html);
                initializeObserver();

                if (userId) {
                    markWishlistProducts(items.map(function (x) { return x.productId; }));
                }
            }).fail(function (err) {
                console.error('Failed to load products', err);
                productGrid.html('<div style="grid-column: 1/-1; text-align: center; padding: 40px; font-size: 16px; color: #ff3333;">Failed to load products.</div>');
            });
        }

        // Back button navigation
        function fnGoBackCategory() {
            if (currentView === 'products') {
                fnLoadSubCategories(selectedMainCategoryId, selectedMainCategoryName);
            } else if (currentView === 'sub') {
                loadMainCategories();
            }
        }

        // Helper to initialize Observer for transition animations
        function initializeObserver() {
            const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        obs.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
        }

        // Mark Wishlist logic
        function markWishlistProducts(productIds) {
            $.ajax({
                url: '@Url.Action("checkWishlistStatus", "Website")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    mstUserId: userId,
                    productIds: productIds
                }),
                success: function (res) {
                    if (res && res.success && res.data) {
                        res.data.forEach(function (status) {
                            if (status.isInWishlist) {
                                const btn = $(`.wishlist-heart[data-id="${status.productId}"]`);
                                btn.addClass('active');
                                btn.find('.wishlist-icon').attr('src', '/images/heart-filled.webp');
                            }
                        });
                    }
                }
            });
        }

        // Initial Load
        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const mainCatParam = parseInt(urlParams.get('mainCategoryId')) || 0;
            const subCatParam = parseInt(urlParams.get('subCategoryId')) || 0;

            if (subCatParam > 0) {
                fnLoadProducts(subCatParam, 'Collection');
            } else if (mainCatParam > 0) {
                fnLoadSubCategories(mainCatParam, 'Collection');
            } else {
                sessionStorage.removeItem('selectedCategoryId');
                sessionStorage.removeItem('selectedSubCategoryId');
                loadMainCategories();
            }
        });
    </script>
}